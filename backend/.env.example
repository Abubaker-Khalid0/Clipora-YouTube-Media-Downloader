# Backend Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to source control

# Internal API key shared between Next.js proxy and FastAPI backend
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=your_64_char_hex_key_here

# Next.js frontend origin — used for CORS allow-list
FRONTEND_URL=http://localhost:3000

# Temporary file storage directory (relative to backend/ or absolute)
TEMP_DIR=storage/temp/

# How often (in seconds) the temp-file cleanup job runs. Default: 300 (5 min)
CLEANUP_INTERVAL_SECONDS=300

# How old a file must be (in minutes) before cleanup removes it. Default: 30
MAX_FILE_AGE_MINUTES=30

# Download hang protection
DOWNLOAD_TIMEOUT_SECONDS=1800
